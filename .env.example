# ---- Database ----
# Async DSN (asyncpg driver). Host is localhost when Postgres runs via docker-compose.
# NOTE: docker-compose.yml publishes Postgres on host port 5435, not 5432.
DATABASE_URL=postgresql+asyncpg://nepsocial:nepsocial@localhost:5435/nepsocial

# Postgres container credentials (consumed by docker-compose.yml)
POSTGRES_USER=nepsocial
POSTGRES_PASSWORD=nepsocial
POSTGRES_DB=nepsocial

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Token encryption (Meta access tokens at rest) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---- Meta app (Facebook Login for Business) ----
# One Meta app serves both the login flow and the webhooks. The legacy INSTAGRAM_APP_ID /
# INSTAGRAM_APP_SECRET / INSTAGRAM_REDIRECT_URI names are still accepted, so an existing
# deployment keeps working while you migrate.
META_APP_ID=
META_APP_SECRET=
# Must EXACTLY match a redirect URI registered in the Meta app dashboard under
# Facebook Login for Business -> Settings -> Valid OAuth Redirect URIs.
# Local dev needs an HTTPS tunnel, e.g.
#   https://<subdomain>.ngrok-free.app/api/v1/social-accounts/facebook/callback
META_REDIRECT_URI=

# Permissions requested at login. pages_read_engagement is a required dependency for the
# Instagram User node and business_management is in Meta's Instagram-messaging setup list;
# omitting either gives you a login that succeeds but reads nothing.
# pages_messaging is Messenger-only — drop it if App Review pushes back.
META_SCOPES=instagram_basic,instagram_manage_messages,pages_manage_metadata,pages_show_list,pages_read_engagement,business_management,pages_messaging

# Webhook callback URL = https://<host>/api/v1/webhooks/instagram
# Paste this same string into the App Dashboard's webhook "Verify token" field.
# Subscribe the **Instagram** object (not Page) — Instagram DMs arrive as
# {"object": "instagram"} with entry[].id = your Instagram professional account id.
META_WEBHOOK_VERIFY_TOKEN=

# ---- Graph API transport ----
GRAPH_API_VERSION=v21.0
GRAPH_BASE_URL=https://graph.facebook.com
GRAPH_TIMEOUT_SECONDS=20
# Retries cover 429/5xx/transport blips and Meta's transient codes (1, 2, 4, 17, 32, 341, 613).
GRAPH_MAX_ATTEMPTS=4
GRAPH_BACKOFF_BASE_SECONDS=0.5
GRAPH_BACKOFF_MAX_SECONDS=8
# The Conversations API allows ~2 calls/second per Instagram account, and Meta flags sudden
# volume changes as abuse (error 613, subcode 1996). Paginated crawls are paced to this.
GRAPH_MIN_INTERVAL_SECONDS=0.5

# ---- Historical conversation import ----
SYNC_PAGE_SIZE=25
SYNC_MAX_CONVERSATIONS=2000
SYNC_MAX_MESSAGES_PER_CONVERSATION=500
# Import history automatically when an account is connected (otherwise the inbox is empty
# until someone happens to write in).
AUTO_SYNC_ON_CONNECT=true

# Where the OAuth callback sends the browser after success
FRONTEND_URL=http://localhost:3000

# ---- Session cookie (handed to the dashboard after OAuth) ----
SESSION_COOKIE_NAME=ns_session
# ENVIRONMENT=production FORCES this on regardless of what you put here, because a session
# cookie without the Secure attribute can be replayed over plain HTTP. You only need to set
# it explicitly for a non-production environment that happens to be served over HTTPS.
COOKIE_SECURE=false
# "none" is only needed if the browser calls this API cross-site over HTTPS. The Next.js
# frontend proxies /api/v1, so the cookie is first-party and "lax" is correct.
COOKIE_SAMESITE=lax

# ---- App ----
# development | production — this is load-bearing, not decorative:
#   production -> forces COOKIE_SECURE on, raises the log level to INFO, disables
#                 /docs, /redoc and /openapi.json, and logs an ERROR for any secret still
#                 holding a .env.example placeholder value.
ENVIRONMENT=development
# Blank = DEBUG locally, INFO in production.
LOG_LEVEL=
