# ---- Database ----
# Async DSN (asyncpg driver). Host is localhost when Postgres runs via docker-compose.
DATABASE_URL=postgresql+asyncpg://nepsocial:nepsocial@localhost:5432/nepsocial

# Postgres container credentials (consumed by docker-compose.yml)
POSTGRES_USER=nepsocial
POSTGRES_PASSWORD=nepsocial
POSTGRES_DB=nepsocial

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Token encryption (Meta access tokens at rest) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---- Instagram OAuth (Instagram API with Instagram Login) ----
# From your Meta app: App settings -> Instagram -> API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must EXACTLY match a redirect URI registered in the Meta app dashboard.
# Local dev needs an HTTPS tunnel, e.g. https://<subdomain>.ngrok-free.app/api/v1/social-accounts/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages
# Webhook callback URL = https://<host>/api/v1/webhooks/instagram ; verify token is any string you choose
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Messenger: callback URL = https://<host>/api/v1/webhooks/facebook (object "Page", fields messages + message_echoes);
# the signature is checked with META_APP_SECRET
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Facebook Login ("Connect Facebook" button; secret = META_APP_SECRET). Redirect URI must also be
# registered in the Meta app: Facebook Login -> Settings -> Valid OAuth Redirect URIs
FACEBOOK_APP_ID=
FACEBOOK_REDIRECT_URI=https://<host>/api/v1/social-accounts/facebook/callback

# Where the OAuth callback sends the browser after success
FRONTEND_URL=http://localhost:3000

# ---- Session cookie (handed to the dashboard after OAuth) ----
SESSION_COOKIE_NAME=ns_session
# In production over HTTPS with a cross-site frontend: COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- App ----
ENVIRONMENT=development
META_APP_SECRET=change-me-to-a-long-random-string

WABA_TOKEN=
WABA_PHONE_NUMBER_ID=
# "Connect WhatsApp" button (Embedded Signup; also needs FACEBOOK_APP_ID + META_APP_SECRET). One for the
# whole app, not per tenant: Facebook Login for Business -> Configurations -> the "WhatsApp Embedded
# Signup" one (product WhatsApp Cloud API, asset WhatsApp accounts). The site's domain must be under
# Facebook Login for Business -> Settings -> Allowed domains for the JavaScript SDK.
WHATSAPP_CONFIG_ID=

# ---- Outgoing mail (SMTP) � leave MAIL_HOST empty in dev to just log verification links ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sanchar

# ---- LLM (auto-reply) ----
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Suggests a product name + tags for uploaded shop photos; any Groq model that accepts images
VISION_MODEL=qwen/qwen3.8-27b
HUMAN_PAUSE_MINUTES=10

# ---- Object storage (MinIO, S3-compatible) for admin-uploaded shop images ----
# Use a dedicated bucket + a scoped access key, never the MinIO root user.
S3_ENDPOINT=https://minio.utsavupahar.com
S3_BUCKET=sanchar
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Public base of the bucket; objects under public/ must allow anonymous read (Meta fetches DM images by URL)
S3_PUBLIC_BASE_URL=https://minio.utsavupahar.com/sanchar
