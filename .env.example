# ---- Database ----
# Async DSN (asyncpg driver). Host is localhost when Postgres runs via docker-compose.
DATABASE_URL=postgresql+asyncpg://nepsocial:nepsocial@localhost:5432/nepsocial

# Postgres container credentials (consumed by docker-compose.yml)
POSTGRES_USER=nepsocial
POSTGRES_PASSWORD=nepsocial
POSTGRES_DB=nepsocial

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Token encryption (Meta access tokens at rest) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---- Instagram OAuth (Instagram API with Instagram Login) ----
# From your Meta app: App settings -> Instagram -> API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must EXACTLY match a redirect URI registered in the Meta app dashboard.
# Local dev needs an HTTPS tunnel, e.g. https://<subdomain>.ngrok-free.app/api/v1/social-accounts/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages
# Webhook callback URL = https://<host>/api/v1/webhooks/instagram ; verify token is any string you choose
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Where the OAuth callback sends the browser after success
FRONTEND_URL=http://localhost:3000

# ---- Session cookie (handed to the dashboard after OAuth) ----
SESSION_COOKIE_NAME=ns_session
# In production over HTTPS with a cross-site frontend: COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- App ----
ENVIRONMENT=development
META_APP_SECRET=change-me-to-a-long-random-string
